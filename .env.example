# start:aigc. 环境变量示例（复制为实际配置时勿提交到版本库）
# MySQL 连接（运行与集成测试共用；服务器库名/账号建议值见 docs/MySQL数据库改造方案.md 第 18 节）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gold_quote
DB_USER=gold_quote_app
DB_PASSWORD=
DB_POOL_SIZE=5

# 集成测试管理连接（需建/删库权限，仅本地开发使用；未设置时回落上方 DB_*）
# DB_TEST_HOST=127.0.0.1
# DB_TEST_PORT=3306
# DB_TEST_USER=root
# DB_TEST_PASSWORD=

# 服务
# PORT=3188
# HOST=127.0.0.1
# PUBLIC_ORIGIN=http://192.168.1.100:3188
# end:aigc.

# start:aigc. Redis 访问状态存储（方案 §2/§10/§14，仅存访问状态，不参与行情采集与快照）
# 客户端 ioredis，兼容 Redis 4（本机 2.8.9 只用于本地子集验证，上线以服务器 4.0.11 为准）
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_CONNECT_TIMEOUT_MS=2000
# REDIS_COMMAND_TIMEOUT_MS=1000
# end:aigc.

# start:aigc. 访问统计容量与阈值（方案 §6/§4，第二批访问管理）
# ACCESS_STATS_MAX_IPS=10000        # 最近 24 小时跟踪 IP 上限，超出计入"其他访问"聚合
# ACCESS_STATS_RETENTION_HOURS=48   # Redis 分钟桶保留（迟到补传窗口）
# ACCESS_SESSION_DEDUP_MAX=100      # 单 IP 10 分钟会话去重上限（显示"100+，已截断"）
# ACCESS_YELLOW_WDENY_PERMIN=5      # 黄灯：最近完整 1 分钟应限流请求次数阈值
# ACCESS_YELLOW_REQ_10M=50          # 黄灯：10 分钟请求量下限（与无会话占比联合判定）
# ACCESS_YELLOW_NOSESS_PCT=80       # 黄灯：10 分钟无有效会话占比（百分比）
# ACCESS_YELLOW_ISSUE_PERMIN=20     # 黄灯：最近完整 1 分钟新建会话数阈值
# end:aigc.

# start:aigc. 访问保护（方案 §15.3，不设置全部用默认值；非法值启动即报错）
# 保护模式：off=关闭 / observe=观测（默认，同一套判定逻辑只记"会被拒"指标）/ enforce=强制拒绝
# PROTECT_MODE=observe
# 可信代理：1=仅信任本机回环连接上的 CLIENT_IP_HEADER（由 Nginx 覆写）；生产 Nginx 反代后开启
# TRUST_PROXY=0
# CLIENT_IP_HEADER=x-real-ip
# 限流初值（每分钟持续速率 + 突发余量；集中出口大屏场景按 §15.3 单独调整后压测）
# QUOTE_SESSION_RATE_PER_MIN=240
# QUOTE_SESSION_BURST=30
# QUOTE_IP_RATE_PER_MIN=600
# QUOTE_IP_BURST=120
# SESSION_ISSUE_RATE_PER_MIN=30
# SESSION_ISSUE_BURST=10
# 访客会话
# VIEWER_IDLE_MINUTES=30
# VIEWER_COOKIE_MAX_AGE_DAYS=7
# VIEWER_MAX_SESSIONS=10000
# 报价快照缓存 TTL（毫秒）：至多复用约该时长的快照，非精确时效承诺（§14.4 规则7）
# SNAPSHOT_CACHE_TTL_MS=1000
# end:aigc.
